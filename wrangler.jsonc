{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newsroom-million-challenge",
  "main": "worker.js",
  "compatibility_date": "2026-10-26",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "newsroom-million-game", "database_id": "00000000-0000-0000-0000-000000000000" }
  ]
}
